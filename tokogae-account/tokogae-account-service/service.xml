<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="true" dependency-injector="ds" mvcc-enabled="true" package-path="com.tokogae.account">
	<author>Amos Fong</author>
	<namespace>TOKOGAE</namespace>
	<entity local-service="true" name="Subject" remote-service="true">

		<!-- PK fields -->

		<column name="subjectId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="firstName" type="String" />
		<column name="lastName" type="String" />
		<column name="displayName" type="String" />
		<column name="gender" type="int" />
		<column name="birthday" type="Date" />

		<!-- Finder methods -->

		<finder name="UserId" return-type="Collection">
			<finder-column name="userId" />
		</finder>
	</entity>
</service-builder>