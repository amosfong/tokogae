<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="false" dependency-injector="ds" mvcc-enabled="true" package-path="com.tokogae.data.event">
	<author>Amos Fong</author>
	<namespace>TOKOGAE_Data</namespace>
	<entity local-service="true" name="FoodItem" remote-service="true">

		<!-- PK fields -->

		<column name="foodItemId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="createDate" type="Date" />

		<!-- Other fields -->

		<column name="name" type="String" />
		<column name="locationOfOrigin" type="String" />
		<column name="brand" type="String" />
		<column name="quantity" type="long" />
		<column name="quantityUnit" type="String" />
	</entity>
</service-builder>