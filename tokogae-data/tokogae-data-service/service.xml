<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="true" dependency-injector="ds" mvcc-enabled="true" package-path="com.tokogae.data">
	<author>Amos Fong</author>
	<namespace>TOKOGAEData</namespace>
	<entity local-service="true" name="Phrase" remote-service="true">

		<!-- PK fields -->

		<column name="phraseId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />

		<!-- Other fields -->

		<column name="text" type="String" />

		<!-- Finder methods -->

		<finder name="Text" return-type="Phrase" unique="true">
			<finder-column name="text" />
		</finder>
	</entity>
	<entity local-service="true" name="PhraseUsage" remote-service="true">

		<!-- PK fields -->

		<column name="phraseUsageId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="createDate" type="Date" />

		<!-- Other fields -->

		<column name="phraseId" type="long" />
		<column name="classNameId" type="long" />
		<column name="classPK" type="long" />
		<column name="attributesHashCode" type="int" />

		<!-- Finder methods -->

		<finder name="PhraseId" return-type="Collection">
			<finder-column name="phraseId" />
		</finder>
		<finder name="C_C" return-type="PhraseUsage">
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
		</finder>
		<finder name="C_C_AHC" return-type="Collection">
			<finder-column name="companyId" />
			<finder-column name="classNameId" />
			<finder-column name="attributesHashCode" />
		</finder>
	</entity>
</service-builder>